ENVIRONMENT=dev
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./paudc.db
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_AUDIENCE=paudc-api
AUTH_COOKIE_NAME=paudc_session
# Use none only when frontend and backend are on different sites; production HTTPS is required.
AUTH_COOKIE_SAMESITE=lax
OIDC_REQUIRE_VERIFIED_EMAIL=true
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# Server-side destination for public contact, registration, and waitlist forms.
# Keep this out of frontend bundles so abuse controls cannot be bypassed.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/replace-me/exec

# Supply one Firebase credential source. Never commit the credential file.
FIREBASE_CREDENTIALS_FILE=C:/path/outside/repository/firebase-service-account.json
# FIREBASE_CREDENTIALS_JSON={...}
